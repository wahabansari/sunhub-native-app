# Copy this file to .env.local and fill in values for your environment.
# EXPO_PUBLIC_* values are embedded in the app bundle and are NOT secret.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=https://api.qas.sunhub.com
EXPO_PUBLIC_BROKER_API_BASE_URL=https://broker-api.qas.sunhub.com/api
EXPO_PUBLIC_MEDIA_BASE_URL=https://media.sunhub.com
EXPO_PUBLIC_API_VERSION=/v1
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=60000
EXPO_PUBLIC_LOG_LEVEL=warn
# Stripe publishable key (pk_test_… or pk_live_…). Public by design; NEVER put a secret key (sk_…) here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
