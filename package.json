{
  "name": "sunhub-native-dash-app",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test -- --runInBand"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.17",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
